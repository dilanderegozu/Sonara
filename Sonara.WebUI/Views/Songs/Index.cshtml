@model List<Sonara.WebUI.Services.AllSongDto>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sonara — Tüm Şarkılar</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0B0710; --surface:#171120; --surface-2:#1E1729;
    --text:#FFFFFF; --text-dim:rgba(255,255,255,.65); --text-faint:rgba(255,255,255,.4);
    --accent:#C64BFF; --accent-2:#FF6FA0; --accent-3:#6EE7D8;
    --line:rgba(255,255,255,0.10);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{background:var(--bg); color:var(--text); font-family:'Inter',sans-serif; min-height:100vh;}
  a{color:inherit; text-decoration:none;}

  .topbar{
    position:sticky; top:0; z-index:20; display:flex; align-items:center;
    justify-content:space-between; padding:20px clamp(20px,4vw,56px);
    background:rgba(11,7,16,0.85); backdrop-filter:blur(12px);
    border-bottom:1px solid var(--line);
  }
  .mark{font-weight:800; font-size:18px; letter-spacing:-0.02em;}
  .nav-links{display:flex; gap:28px; font-size:14px; color:var(--text-dim);}
  .nav-links a{padding-bottom:4px; border-bottom:1px solid transparent; transition:.2s;}
  .nav-links a.active{color:#fff; border-color:var(--accent);}
  .nav-links a:hover{color:#fff;}
  .avatar{
    width:32px; height:32px; border-radius:50%;
    background:linear-gradient(135deg, var(--accent), var(--accent-2));
    display:flex; align-items:center; justify-content:center; font-weight:700; font-size:13px; color:#fff;
  }

  main{padding:0 clamp(20px,4vw,56px) 120px;}

  .page-head{
    padding:56px 0 8px; text-align:center; position:relative;
  }
  .page-head::before{
    content:''; position:absolute; top:-40px; left:50%; transform:translateX(-50%);
    width:500px; height:220px; background:radial-gradient(ellipse, rgba(198,75,255,.25), transparent 70%);
    pointer-events:none; z-index:0;
  }
  .page-head h1{
    position:relative; z-index:1; font-weight:800; font-size:clamp(28px,3.6vw,40px); margin:0 0 10px; letter-spacing:-0.02em;
  }
  .page-head .sub{position:relative; z-index:1; font-size:14px; color:var(--text-dim); margin:0 0 6px;}
  .page-head .sub-accent{position:relative; z-index:1; font-size:13px; color:var(--accent-3); margin:0;}

  .reco-strip{
    margin:44px 0 40px; background:linear-gradient(155deg, rgba(198,75,255,.10), rgba(255,111,160,.05));
    border:1px solid rgba(198,75,255,.28); border-radius:16px; padding:26px 28px;
  }
  .reco-head{display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; flex-wrap:wrap; gap:10px;}
  .reco-head .reco-title{display:flex; align-items:center; gap:10px; font-weight:700; font-size:15px;}
  .reco-head .reco-title svg{stroke:#FFD87A; fill:#FFD87A;}
  .reco-badge{
    font-size:10.5px; font-weight:700; letter-spacing:.04em; color:#1A1206;
    background:linear-gradient(120deg,#FFD87A,#FFB84D); padding:6px 12px; border-radius:999px;
  }
  .reco-list{display:flex; gap:18px; overflow-x:auto; padding-bottom:4px;}
  .reco-card{flex:0 0 130px; cursor:pointer;}
  .reco-art{
    width:130px; height:130px; border-radius:12px; position:relative; overflow:hidden;
    background-size:cover; background-position:center; background-color:var(--surface-2);
    display:flex; align-items:flex-end; justify-content:flex-end; padding:8px;
    transition:transform .25s;
  }
  .reco-card:hover .reco-art{transform:translateY(-4px);}
  .reco-play{
    width:28px; height:28px; border-radius:50%;
    background:linear-gradient(135deg, var(--accent), var(--accent-2));
    display:flex; align-items:center; justify-content:center; opacity:0; transition:opacity .2s;
  }
  .reco-card:hover .reco-play{opacity:1;}
  .reco-play svg{width:11px; height:11px; fill:#fff; margin-left:1px;}
  .reco-card .r-title{font-size:12.5px; font-weight:600; margin-top:10px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
  .reco-card .r-artist{font-size:11px; color:var(--text-dim); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}

  .toolbar{display:flex; gap:14px; margin-bottom:28px; flex-wrap:wrap;}
  .search-box{
    flex:1; min-width:240px; display:flex; align-items:center; gap:10px;
    background:var(--surface); border:1px solid var(--line); border-radius:10px; padding:13px 18px;
  }
  .search-box svg{stroke:var(--text-faint); flex:none;}
  .search-box input{
    background:none; border:none; outline:none; color:#fff; font-size:14px; width:100%; font-family:'Inter',sans-serif;
  }
  .search-box input::placeholder{color:var(--text-faint);}

  .list-meta{font-size:13px; color:var(--text-dim); margin-bottom:20px;}

  .song-grid{
    display:grid; grid-template-columns:repeat(auto-fill, minmax(210px, 1fr)); gap:22px;
  }
  .song-card{
    background:var(--surface); border:1px solid var(--line); border-radius:14px; padding:16px;
    cursor:pointer; transition:transform .25s, border-color .25s;
  }
  .song-card:hover{transform:translateY(-4px); border-color:rgba(198,75,255,.4);}
  .song-art{
    width:100%; aspect-ratio:1/1; border-radius:10px; position:relative; overflow:hidden;
    background-size:cover; background-position:center; background-color:var(--surface-2);
    display:flex; align-items:flex-end; padding:12px; margin-bottom:14px;
  }
  .song-art::after{content:''; position:absolute; inset:0; background:linear-gradient(180deg, transparent 45%, rgba(0,0,0,.6) 100%);}
  .song-play{
    position:relative; z-index:2; width:38px; height:38px; border-radius:50%;
    background:linear-gradient(135deg, var(--accent), var(--accent-2));
    display:flex; align-items:center; justify-content:center;
    opacity:0; transform:translateY(6px); transition:opacity .25s, transform .25s;
    box-shadow:0 10px 24px -6px rgba(198,75,255,.7);
  }
  .song-card:hover .song-play{opacity:1; transform:translateY(0);}
  .song-play svg{width:14px; height:14px; fill:#fff; margin-left:1px;}
  .song-card .s-title{font-size:14.5px; font-weight:700; margin-bottom:3px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
  .song-card .s-artist{font-size:12.5px; color:var(--text-dim); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; cursor:pointer;}
  .song-card .s-artist:hover{color:var(--accent-3);}

  .empty-state{text-align:center; padding:80px 20px; color:var(--text-dim); font-size:14px;}

  .miniplayer{
    position:fixed; left:0; right:0; bottom:0; z-index:30;
    background:rgba(15,10,20,0.95); backdrop-filter:blur(16px);
    border-top:1px solid var(--line);
    display:flex; align-items:center; gap:20px;
    padding:12px clamp(20px,4vw,56px);
  }
  .mp-track{display:flex; align-items:center; gap:12px; width:240px; flex:none;}
  .mp-art{width:46px; height:46px; border-radius:8px; flex:none; background-size:cover; background-position:center; background-color:var(--surface-2);}
  .mp-title{font-size:13.5px; font-weight:600;}
  .mp-artist{font-size:11.5px; color:var(--text-dim);}
  .mp-center{flex:1; display:flex; flex-direction:column; align-items:center; gap:6px; max-width:520px; margin:0 auto;}
  .mp-controls{display:flex; align-items:center; gap:18px;}
  .mp-controls button{background:none; border:none; color:var(--text-dim); cursor:pointer; padding:4px; display:flex;}
  .mp-controls button:hover{color:#fff;}
  .mp-play-btn{
    width:34px; height:34px; border-radius:50%; background:linear-gradient(135deg, var(--accent), var(--accent-2));
    display:flex; align-items:center; justify-content:center; color:#fff !important;
    box-shadow:0 8px 20px -6px rgba(198,75,255,.7);
  }
  .mp-progress{display:flex; align-items:center; gap:8px; width:100%;}
  .mp-progress span{font-family:'JetBrains Mono',monospace; font-size:10.5px; color:var(--text-faint); min-width:32px; text-align:center;}
  .mp-bar{flex:1; height:3px; background:var(--line); position:relative; border-radius:3px; cursor:pointer;}
  .mp-bar i{position:absolute; left:0; top:0; bottom:0; width:0%; background:linear-gradient(90deg, var(--accent), var(--accent-2)); border-radius:3px;}
  .mp-right{width:240px; flex:none; display:flex; justify-content:flex-end; align-items:center; gap:16px;}

  .page-head, .reco-strip, .song-card{opacity:0; transform:translateY(12px); animation:rise .55s cubic-bezier(.2,.7,.2,1) forwards;}
  .reco-strip{animation-delay:.06s;}
  @@keyframes rise{to{opacity:1; transform:translateY(0);}}
</style>
</head>
<body>

  @Html.AntiForgeryToken()

  <div class="topbar">
            <div class="mark">Sonara</div>
            <div class="nav-links">
                <a href="/Home/Index">Keşfet</a>
                <a href="/Library/Index">Kütüphane</a>
                <a href="/Artists/Index" >Sanatçılar</a>
                <a href="/Songs/Index" class="active">Şarkılar</a>
            </div>
            <div class="avatar">D</div>
        </div>

  <main>
    <div class="page-head">
      <h1>Tüm Şarkılar</h1>
      <p class="sub">Sistemdeki bütün şarkıları görebilirsin.</p>
      <p class="sub-accent">Paketinin izin vermediği şarkıları dinleyemezsin, ancak hepsini listede görebilirsin.</p>
    </div>

    @if (Model.Any())
    {
        var recs = Model.Take(5).ToList();
        <div class="reco-strip">
          <div class="reco-head">
            <div class="reco-title">
              <svg width="16" height="16" viewBox="0 0 24 24" stroke-width="0"><path d="M12 2l2.9 6.9L22 9.6l-5.5 4.8L18 22l-6-3.6L6 22l1.5-7.6L2 9.6l7.1-.7z"/></svg>
              Bunları da sevebilirsiniz
            </div>
            <div class="reco-badge">Dinleme zevkine göre</div>
          </div>
          <div class="reco-list">
            @foreach (var r in recs)
            {
                <div class="reco-card" data-song-id="@r.SongId" data-title="@r.Title" data-artist="@r.ArtistName" data-cover="@r.CoverImageUrl" onclick="playSong(@r.SongId, this)">
                    <div class="reco-art" style="@(string.IsNullOrEmpty(r.CoverImageUrl) ? "" : $"background-image:url('{r.CoverImageUrl}')")">
                        <div class="reco-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
                    </div>
                    <div class="r-title">@r.Title</div>
                    <div class="r-artist">@r.ArtistName</div>
                </div>
            }
          </div>
        </div>

        <div class="toolbar">
          <div class="search-box">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            <input type="text" id="searchInput" placeholder="Şarkı, sanatçı ara..." oninput="filterSongs()" />
          </div>
        </div>

        <p class="list-meta" id="listMeta">@Model.Count şarkı listeleniyor</p>

        <div class="song-grid" id="songGrid">
            @foreach (var song in Model)
            {
                <div class="song-card" data-search="@($"{song.Title} {song.ArtistName}".ToLower())" data-song-id="@song.SongId" data-title="@song.Title" data-artist="@song.ArtistName" data-cover="@song.CoverImageUrl" onclick="playSong(@song.SongId, this)">
                    <div class="song-art" style="@(string.IsNullOrEmpty(song.CoverImageUrl) ? "" : $"background-image:url('{song.CoverImageUrl}')")">
                        <div class="song-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
                    </div>
                    <div class="s-title">@song.Title</div>
                    <div class="s-artist" onclick="event.stopPropagation(); location.href='/Songs/Artist/@song.ArtistId'">@song.ArtistName</div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">Henüz hiç şarkı eklenmemiş.</div>
    }
  </main>

  <audio id="globalPlayer" preload="none"></audio>

  <div class="miniplayer">
    <div class="mp-track">
      <div class="mp-art" id="mpArt"></div>
      <div>
        <div class="mp-title" id="mpTitle">Bir şarkı seç</div>
        <div class="mp-artist" id="mpArtist">—</div>
      </div>
    </div>
    <div class="mp-center">
      <div class="mp-controls">
        <button class="mp-play-btn" id="mpPlayBtn" title="Oynat/Duraklat" onclick="togglePlayPause()">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" id="mpPlayIcon"><path d="M8 5v14l11-7z"/></svg>
        </button>
      </div>
      <div class="mp-progress">
        <span id="mpCurrentTime">0:00</span>
        <div class="mp-bar" id="mpBar" onclick="seekTo(event)"><i id="mpBarFill"></i></div>
        <span id="mpDuration">0:00</span>
      </div>
    </div>
    <div class="mp-right"></div>
  </div>

<script>
  function getAntiForgeryToken(){
    const el = document.querySelector('input[name="__RequestVerificationToken"]');
    return el ? el.value : '';
  }

  const audio = document.getElementById('globalPlayer');
  const mpTitle = document.getElementById('mpTitle');
  const mpArtist = document.getElementById('mpArtist');
  const mpArt = document.getElementById('mpArt');
  const mpPlayIcon = document.getElementById('mpPlayIcon');
  const mpBarFill = document.getElementById('mpBarFill');
  const mpCurrentTime = document.getElementById('mpCurrentTime');
  const mpDuration = document.getElementById('mpDuration');

  function formatTime(totalSeconds){
    const s = Math.floor(totalSeconds % 60).toString().padStart(2,'0');
    const m = Math.floor(totalSeconds / 60);
    return m + ':' + s;
  }

  async function playSong(songId, cardEl){
    try{
      const response = await fetch('/Home/PlaySong', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'RequestVerificationToken': getAntiForgeryToken()
        },
        body: JSON.stringify({ songId: songId })
      });

      if(!response.ok){
        const err = await response.json().catch(()=>({message:'Bu şarkı şu an oynatılamıyor.'}));
        alert(err.message);
        return;
      }

      const data = await response.json();
      audio.src = data.audioUrl;
      audio.play();

      mpPlayIcon.innerHTML = '<path d="M6 5h4v14H6zM14 5h4v14h-4z"/>';
      mpTitle.textContent = data.title;
      mpArtist.textContent = cardEl ? cardEl.dataset.artist : '';
      const coverUrl = cardEl ? cardEl.dataset.cover : null;
      mpArt.style.backgroundImage = coverUrl ? `url('${coverUrl}')` : '';
    } catch(e){
      console.error(e);
      alert('Şarkı oynatılırken bir hata oluştu.');
    }
  }

  function togglePlayPause(){
    if(!audio.src) return;
    if(audio.paused){
      audio.play();
      mpPlayIcon.innerHTML = '<path d="M6 5h4v14H6zM14 5h4v14h-4z"/>';
    } else {
      audio.pause();
      mpPlayIcon.innerHTML = '<path d="M8 5v14l11-7z"/>';
    }
  }

  function seekTo(evt){
    if(!audio.duration) return;
    const bar = document.getElementById('mpBar');
    const rect = bar.getBoundingClientRect();
    const ratio = (evt.clientX - rect.left) / rect.width;
    audio.currentTime = ratio * audio.duration;
  }

  audio.addEventListener('timeupdate', function(){
    if(!audio.duration) return;
    const percent = (audio.currentTime / audio.duration) * 100;
    mpBarFill.style.width = percent + '%';
    mpCurrentTime.textContent = formatTime(audio.currentTime);
    mpDuration.textContent = formatTime(audio.duration);
  });

  audio.addEventListener('ended', function(){
    mpPlayIcon.innerHTML = '<path d="M8 5v14l11-7z"/>';
  });

  function filterSongs(){
    const q = document.getElementById('searchInput').value.trim().toLowerCase();
    const cards = document.querySelectorAll('#songGrid .song-card');
    let visible = 0;
    cards.forEach(c=>{
      const match = c.dataset.search.includes(q);
      c.style.display = match ? '' : 'none';
      if(match) visible++;
    });
    document.getElementById('listMeta').textContent = visible + ' şarkı listeleniyor';
  }
</script>
</body>
</html>
