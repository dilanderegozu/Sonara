@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sonara Admin — Ruh Hali Ekle</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<style>
  :root{
    --sidebar:#111113; --sidebar-hover:#1C1C1F; --sidebar-line:rgba(255,255,255,0.08);
    --bg:#FAFAFB; --surface:#FFFFFF; --border:#EBEBEF;
    --text:#0E0E10; --text-dim:#68686F; --text-faint:#9C9CA3;
    --accent:#615FFF; --accent-2:#8B7CFF; --accent-soft:#EFEEFF;
    --shadow-sm:0 1px 2px rgba(14,14,16,0.04);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{background:var(--bg); color:var(--text); font-family:'Inter',sans-serif; min-height:100vh; -webkit-font-smoothing:antialiased;}
  a{color:inherit; text-decoration:none;}

  .shell{display:flex; min-height:100vh;}
  .sidebar{width:236px; flex:none; background:var(--sidebar); color:#fff; padding:20px 14px; display:flex; flex-direction:column; position:sticky; top:0; height:100vh;}
  .sb-brand{display:flex; align-items:center; gap:10px; padding:6px 8px 22px;}
  .sb-brand .mark{width:26px; height:26px; border-radius:7px; background:linear-gradient(135deg, var(--accent), var(--accent-2)); display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:800;}
  .sb-brand .name{font-weight:700; font-size:14.5px; letter-spacing:-0.01em;}
  .sb-brand .name span{color:rgba(255,255,255,0.4); font-weight:500;}
  .sb-search{display:flex; align-items:center; gap:8px; background:var(--sidebar-hover); border:1px solid var(--sidebar-line); border-radius:9px; padding:8px 10px; font-size:12.5px; color:rgba(255,255,255,0.45); margin-bottom:20px;}
  .sb-search kbd{margin-left:auto; font-size:10.5px; background:rgba(255,255,255,0.08); padding:2px 6px; border-radius:5px; font-family:inherit;}
  .sb-section{font-size:10.5px; font-weight:700; letter-spacing:.07em; text-transform:uppercase; color:rgba(255,255,255,0.28); padding:14px 10px 8px;}
  .sb-nav{display:flex; flex-direction:column; gap:1px;}
  .sb-nav a{display:flex; align-items:center; gap:10px; padding:8px 10px; border-radius:8px; font-size:13.5px; font-weight:500; color:rgba(255,255,255,0.62); transition:background .15s, color .15s;}
  .sb-nav a i{font-size:15px; width:16px; text-align:center;}
  .sb-nav a:hover{background:var(--sidebar-hover); color:#fff;}
  .sb-nav a.active{background:rgba(97,95,255,0.18); color:#fff;}
  .sb-nav a.active i{color:var(--accent-2);}
  .sb-foot{margin-top:auto; padding-top:16px; border-top:1px solid var(--sidebar-line);}
  .sb-user{display:flex; align-items:center; gap:10px; padding:8px; border-radius:9px;}
  .sb-user .avatar{width:28px; height:28px; border-radius:50%; background:linear-gradient(135deg,var(--accent),var(--accent-2)); display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700; flex:none;}
  .sb-user .who{font-size:12.5px; font-weight:600;}
  .sb-user .role{font-size:11px; color:rgba(255,255,255,0.4);}

  .content{flex:1; min-width:0;}
  .topbar{position:sticky; top:0; z-index:10; display:flex; align-items:center; justify-content:space-between; padding:0 32px; height:60px; background:rgba(250,250,251,0.85); backdrop-filter:blur(10px); border-bottom:1px solid var(--border);}
  .breadcrumb{font-size:13px; color:var(--text-faint); display:flex; align-items:center; gap:6px;}
  .breadcrumb b{color:var(--text); font-weight:600;}
  .btn-ghost{display:flex; align-items:center; gap:6px; padding:7px 13px; border-radius:8px; border:1px solid var(--border); font-size:12.5px; font-weight:500; color:var(--text-dim); background:#fff; transition:.15s;}
  .btn-ghost:hover{border-color:#D8D8DE; color:var(--text);}

  main{max-width:480px; margin:0 auto; padding:36px 32px 100px;}
  .page-head{margin-bottom:24px;}
  .page-head h1{font-size:26px; font-weight:800; letter-spacing:-0.02em; margin:0 0 4px;}
  .page-head p{font-size:13.5px; color:var(--text-dim); margin:0;}

  .panel{background:var(--surface); border:1px solid var(--border); border-radius:18px; box-shadow:var(--shadow-sm); padding:28px;}
  .field{margin-bottom:20px;}
  .field label{display:block; font-size:12.5px; font-weight:600; color:var(--text-dim); margin-bottom:7px;}
  .field input[type="text"]{
    width:100%; padding:11px 14px; border-radius:10px; border:1px solid var(--border); background:var(--bg);
    font-size:13.5px; font-family:'Inter',sans-serif; color:var(--text); outline:none; transition:border-color .15s, background .15s;
  }
  .field input:focus{border-color:var(--accent); background:#fff;}

  .color-row{display:flex; align-items:center; gap:12px;}
  .color-row input[type="color"]{width:52px; height:44px; border-radius:10px; border:1px solid var(--border); padding:2px; cursor:pointer; background:var(--bg);}
  .color-preview{flex:1; height:44px; border-radius:10px; border:1px solid var(--border); display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:600; color:#fff; transition:background .15s;}

  .preset-row{display:flex; gap:8px; margin-top:10px; flex-wrap:wrap;}
  .preset-swatch{width:26px; height:26px; border-radius:8px; cursor:pointer; border:2px solid transparent; transition:.15s;}
  .preset-swatch:hover{transform:scale(1.1);}

  .submit-row{display:flex; justify-content:flex-end; margin-top:28px;}
  .btn-primary{display:flex; align-items:center; gap:6px; padding:10px 20px; border-radius:10px; border:none; font-size:13px; font-weight:600; color:#fff; background:var(--accent); cursor:pointer; transition:.15s;}
  .btn-primary:hover{background:#5250E8;}

  @@media (max-width:820px){ .sidebar{display:none;} }
</style>
</head>
<body>

  <div class="shell">
    <aside class="sidebar">
      <div class="sb-brand"><span class="mark">S</span><span class="name">Sonara <span>Admin</span></span></div>
      <div class="sb-search"><i class="bi bi-search"></i>Ara<kbd>⌘K</kbd></div>

      <p class="sb-section">Genel</p>
      <div class="sb-nav"><a href="/Admin/Index"><i class="bi bi-grid-1x2-fill"></i>Genel bakış</a></div>

      <p class="sb-section">Katalog</p>
      <div class="sb-nav">
        <a href="/Admin/Songs"><i class="bi bi-music-note-beamed"></i>Şarkılar</a>
        <a href="/Admin/Artists"><i class="bi bi-person-badge"></i>Sanatçılar</a>
        <a href="/Admin/Moods" class="active"><i class="bi bi-palette"></i>Ruh halleri</a>
      </div>

      <p class="sb-section">Sistem</p>
      <div class="sb-nav">
        <a href="/Packages/Index"><i class="bi bi-layers"></i>Paketler</a>
        <a href="/Home/Index"><i class="bi bi-box-arrow-up-right"></i>Siteye dön</a>
      </div>

      <div class="sb-foot">
        <div class="sb-user"><span class="avatar">D</span><div><div class="who">Dilan</div><div class="role">Admin</div></div></div>
      </div>
    </aside>

    <div class="content">
      <div class="topbar">
        <div class="breadcrumb">Admin <i class="bi bi-chevron-right" style="font-size:10px;"></i> <a href="/Admin/Moods">Ruh halleri</a> <i class="bi bi-chevron-right" style="font-size:10px;"></i> <b>Yeni</b></div>
        <a href="/Admin/Moods" class="btn-ghost"><i class="bi bi-arrow-left"></i>Geri</a>
      </div>

      <main>
        <div class="page-head">
          <h1>Yeni ruh hali</h1>
          <p>Yeni bir koleksiyon kategorisi tanımla.</p>
        </div>

        <form class="panel" method="post" asp-action="CreateMood" asp-controller="Admin">
          @Html.AntiForgeryToken()

          <div class="field">
            <label>Ruh hali adı</label>
            <input type="text" name="name" placeholder="örn. Yağmurlu" required />
          </div>

          <div class="field">
            <label>Renk</label>
            <div class="color-row">
              <input type="color" id="colorInput" value="#7FD9C4" onchange="updatePreview()" />
              <div class="color-preview" id="colorPreview" style="background:#7FD9C4;">#7FD9C4</div>
            </div>
            <input type="hidden" name="colorHex" id="colorHexInput" value="#7FD9C4" />
            <div class="preset-row">
              <div class="preset-swatch" style="background:#7FD9C4;" onclick="setPreset('#7FD9C4')"></div>
              <div class="preset-swatch" style="background:#F0A08A;" onclick="setPreset('#F0A08A')"></div>
              <div class="preset-swatch" style="background:#F0C572;" onclick="setPreset('#F0C572')"></div>
              <div class="preset-swatch" style="background:#B9AEE0;" onclick="setPreset('#B9AEE0')"></div>
              <div class="preset-swatch" style="background:#C7CE8E;" onclick="setPreset('#C7CE8E')"></div>
              <div class="preset-swatch" style="background:#93C6E0;" onclick="setPreset('#93C6E0')"></div>
            </div>
          </div>

          <div class="submit-row">
            <button type="submit" class="btn-primary"><i class="bi bi-check-lg"></i>Ruh halini ekle</button>
          </div>
        </form>
      </main>
    </div>
  </div>

<script>
  function updatePreview(){
    const val = document.getElementById('colorInput').value;
    document.getElementById('colorPreview').style.background = val;
    document.getElementById('colorPreview').textContent = val;
    document.getElementById('colorHexInput').value = val;
  }
  function setPreset(hex){
    document.getElementById('colorInput').value = hex;
    updatePreview();
  }
</script>
</body>
</html>
