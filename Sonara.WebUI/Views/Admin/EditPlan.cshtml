@model Sonara.WebUI.Services.PlanDto
@{
    Layout = null;
    var isEdit = Model.Id > 0;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sonara Admin — @(isEdit ? "Paketi Düzenle" : "Yeni Paket")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <style>
            :root {
                --sidebar: #111113;
                --sidebar-hover: #1C1C1F;
                --sidebar-line: rgba(255,255,255,0.08);
                --bg: #FAFAFB;
                --surface: #FFFFFF;
                --border: #EBEBEF;
                --text: #0E0E10;
                --text-dim: #68686F;
                --text-faint: #9C9CA3;
                --accent: #615FFF;
                --accent-2: #8B7CFF;
                --accent-soft: #EFEEFF;
                --green: #0F9D58;
                --shadow-sm: 0 1px 2px rgba(14,14,16,0.04);
            }

            * {
                box-sizing: border-box;
            }

            html, body {
                margin: 0;
                padding: 0;
            }

            body {
                background: var(--bg);
                color: var(--text);
                font-family: 'Inter',sans-serif;
                min-height: 100vh;
                -webkit-font-smoothing: antialiased;
            }

            a {
                color: inherit;
                text-decoration: none;
            }

            .shell {
                display: flex;
                min-height: 100vh;
            }

            .sidebar {
                width: 236px;
                flex: none;
                background: var(--sidebar);
                color: #fff;
                padding: 20px 14px;
                display: flex;
                flex-direction: column;
                position: sticky;
                top: 0;
                height: 100vh;
            }

            .sb-brand {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 6px 8px 22px;
            }

                .sb-brand .mark {
                    width: 26px;
                    height: 26px;
                    border-radius: 7px;
                    background: linear-gradient(135deg, var(--accent), var(--accent-2));
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 12px;
                    font-weight: 800;
                }

                .sb-brand .name {
                    font-weight: 700;
                    font-size: 14.5px;
                    letter-spacing: -0.01em;
                }

                    .sb-brand .name span {
                        color: rgba(255,255,255,0.4);
                        font-weight: 500;
                    }

            .sb-search {
                display: flex;
                align-items: center;
                gap: 8px;
                background: var(--sidebar-hover);
                border: 1px solid var(--sidebar-line);
                border-radius: 9px;
                padding: 8px 10px;
                font-size: 12.5px;
                color: rgba(255,255,255,0.45);
                margin-bottom: 20px;
            }

                .sb-search kbd {
                    margin-left: auto;
                    font-size: 10.5px;
                    background: rgba(255,255,255,0.08);
                    padding: 2px 6px;
                    border-radius: 5px;
                    font-family: inherit;
                }

            .sb-section {
                font-size: 10.5px;
                font-weight: 700;
                letter-spacing: .07em;
                text-transform: uppercase;
                color: rgba(255,255,255,0.28);
                padding: 14px 10px 8px;
            }

            .sb-nav {
                display: flex;
                flex-direction: column;
                gap: 1px;
            }

                .sb-nav a {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    padding: 8px 10px;
                    border-radius: 8px;
                    font-size: 13.5px;
                    font-weight: 500;
                    color: rgba(255,255,255,0.62);
                    transition: background .15s, color .15s;
                }

                    .sb-nav a i {
                        font-size: 15px;
                        width: 16px;
                        text-align: center;
                    }

                    .sb-nav a:hover {
                        background: var(--sidebar-hover);
                        color: #fff;
                    }

                    .sb-nav a.active {
                        background: rgba(97,95,255,0.18);
                        color: #fff;
                    }

                        .sb-nav a.active i {
                            color: var(--accent-2);
                        }

            .sb-foot {
                margin-top: auto;
                padding-top: 16px;
                border-top: 1px solid var(--sidebar-line);
            }

            .sb-user {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 8px;
                border-radius: 9px;
            }

                .sb-user .avatar {
                    width: 28px;
                    height: 28px;
                    border-radius: 50%;
                    background: linear-gradient(135deg,var(--accent),var(--accent-2));
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 12px;
                    font-weight: 700;
                    flex: none;
                }

                .sb-user .who {
                    font-size: 12.5px;
                    font-weight: 600;
                }

                .sb-user .role {
                    font-size: 11px;
                    color: rgba(255,255,255,0.4);
                }

            .content {
                flex: 1;
                min-width: 0;
            }

            .topbar {
                position: sticky;
                top: 0;
                z-index: 10;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 32px;
                height: 60px;
                background: rgba(250,250,251,0.85);
                backdrop-filter: blur(10px);
                border-bottom: 1px solid var(--border);
            }

            .breadcrumb {
                font-size: 13px;
                color: var(--text-faint);
                display: flex;
                align-items: center;
                gap: 6px;
            }

                .breadcrumb b {
                    color: var(--text);
                    font-weight: 600;
                }

            .btn-ghost {
                display: flex;
                align-items: center;
                gap: 6px;
                padding: 7px 13px;
                border-radius: 8px;
                border: 1px solid var(--border);
                font-size: 12.5px;
                font-weight: 500;
                color: var(--text-dim);
                background: #fff;
                transition: .15s;
            }

                .btn-ghost:hover {
                    border-color: #D8D8DE;
                    color: var(--text);
                }

            main {
                max-width: 600px;
                margin: 0 auto;
                padding: 36px 32px 100px;
            }

            .page-head {
                margin-bottom: 24px;
            }

                .page-head h1 {
                    font-size: 26px;
                    font-weight: 800;
                    letter-spacing: -0.02em;
                    margin: 0 0 4px;
                }

                .page-head p {
                    font-size: 13.5px;
                    color: var(--text-dim);
                    margin: 0;
                }

            .panel {
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: 18px;
                box-shadow: var(--shadow-sm);
                padding: 28px;
            }

            .field-row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 16px;
            }

            .field {
                margin-bottom: 20px;
            }

                .field label {
                    display: block;
                    font-size: 12.5px;
                    font-weight: 600;
                    color: var(--text-dim);
                    margin-bottom: 7px;
                }

                .field input[type="text"], .field input[type="number"] {
                    width: 100%;
                    padding: 11px 14px;
                    border-radius: 10px;
                    border: 1px solid var(--border);
                    background: var(--bg);
                    font-size: 13.5px;
                    font-family: 'Inter',sans-serif;
                    color: var(--text);
                    outline: none;
                    transition: border-color .15s, background .15s;
                }

                .field input:focus {
                    border-color: var(--accent);
                    background: #fff;
                }

            .toggle-list {
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .toggle-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 12px 14px;
                border-radius: 10px;
                border: 1px solid var(--border);
                background: var(--bg);
                cursor: pointer;
                transition: .15s;
            }

                .toggle-row.on {
                    background: var(--accent-soft);
                    border-color: var(--accent);
                }

                .toggle-row .txt {
                    font-size: 13px;
                    font-weight: 600;
                }

            .switch {
                width: 36px;
                height: 20px;
                border-radius: 999px;
                background: var(--border);
                position: relative;
                transition: background .2s;
                flex: none;
            }

                .switch::after {
                    content: '';
                    position: absolute;
                    top: 2px;
                    left: 2px;
                    width: 16px;
                    height: 16px;
                    border-radius: 50%;
                    background: #fff;
                    transition: transform .2s;
                    box-shadow: 0 1px 2px rgba(0,0,0,.15);
                }

            .toggle-row.on .switch {
                background: var(--accent);
            }

                .toggle-row.on .switch::after {
                    transform: translateX(16px);
                }

            .toggle-row input {
                display: none;
            }

            .submit-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-top: 28px;
            }

            .btn-primary {
                display: flex;
                align-items: center;
                gap: 6px;
                padding: 10px 20px;
                border-radius: 10px;
                border: none;
                font-size: 13px;
                font-weight: 600;
                color: #fff;
                background: var(--accent);
                cursor: pointer;
                transition: .15s;
            }

                .btn-primary:hover {
                    background: #5250E8;
                }

            @@media (max-width:820px) {
                .sidebar {
                    display: none;
                }

                .field-row {
                    grid-template-columns: 1fr;
                }
            }
    </style>
</head>
<body>

    <div class="shell">
        <aside class="sidebar">
            <div class="sb-brand"><span class="mark">S</span><span class="name">Sonara <span>Admin</span></span></div>
            <div class="sb-search"><i class="bi bi-search"></i>Ara<kbd>⌘K</kbd></div>

            <p class="sb-section">Genel</p>
            <div class="sb-nav"><a href="/Admin/Index"><i class="bi bi-grid-1x2-fill"></i>Genel bakış</a></div>

            <p class="sb-section">Katalog</p>
            <div class="sb-nav">
                <a href="/Admin/Songs"><i class="bi bi-music-note-beamed"></i>Şarkılar</a>
                <a href="/Admin/Artists"><i class="bi bi-person-badge"></i>Sanatçılar</a>
                <a href="/Admin/Moods"><i class="bi bi-palette"></i>Ruh halleri</a>
            </div>

            <p class="sb-section">Sistem</p>
            <div class="sb-nav">
                <a href="/Admin/Plans" class="active"><i class="bi bi-layers"></i>Paketler</a>
                <a href="/Home/Index"><i class="bi bi-box-arrow-up-right"></i>Siteye dön</a>
            </div>

            <div class="sb-foot">
                <div class="sb-user"><span class="avatar">D</span><div><div class="who">Dilan</div><div class="role">Admin</div></div></div>
            </div>
        </aside>

        <div class="content">
            <div class="topbar">
                <div class="breadcrumb">Admin <i class="bi bi-chevron-right" style="font-size:10px;"></i> <a href="/Admin/Plans">Paketler</a> <i class="bi bi-chevron-right" style="font-size:10px;"></i> <b>@(isEdit ? "Düzenle" : "Yeni")</b></div>
                <a href="/Admin/Plans" class="btn-ghost"><i class="bi bi-arrow-left"></i>Geri</a>
            </div>

            <main>
                <div class="page-head">
                    <h1>@(isEdit ? "Paketi düzenle" : "Yeni paket")</h1>
                    <p>@(isEdit ? $"{Model.Name} paketinin ayarlarını güncelle." : "Yeni bir üyelik katmanı tanımla.")</p>
                </div>

                <form class="panel" method="post" asp-action="EditPlan" asp-controller="Admin">
                    @Html.AntiForgeryToken()
                    @if (isEdit)
                    {
                        <input type="hidden" name="id" value="@Model.Id" />
                    }

                    <div class="field">
                        <label>Paket adı</label>
                        <input type="text" name="name" value="@Model.Name" placeholder="örn. Gold" required />
                    </div>

                    <div class="field-row">
                        <div class="field">
                            <label>Seviye</label>
                            <input type="number" name="level" value="@Model.Level" min="0" required />
                        </div>
                        <div class="field">
                            <label>Fiyat (₺)</label>
                            <input type="number" name="price" value="@Model.Price" step="0.01" min="0" required />
                        </div>
                    </div>

                    <div class="field-row">
                        <div class="field">
                            <label>Maks. cihaz sayısı</label>
                            <input type="number" name="maxDeviceCount" value="@Model.MaxDeviceCount" min="1" required />
                        </div>
                        <div class="field">
                            <label>Süre (gün)</label>
                            <input type="number" name="durationInDays" value="@Model.DurationInDays" min="1" required />
                        </div>
                    </div>

                    <div class="field">
                        <label>Özellikler</label>
                        <div class="toggle-list">
                            <div class="toggle-row @(Model.HasAds ? "" : "on")" onclick="toggleAdsFree(this)">
                                <span class="txt">Reklamsız dinleme</span>
                                <span class="switch"></span>
                                <input type="checkbox" name="hasAds" id="hasAds" style="display:none;" @(Model.HasAds ? "checked" : "") />
                            </div>
                            <div class="toggle-row @(Model.HasHighQualityAudio ? "on" : "")" onclick="toggleFeature(this,'hasHighQualityAudio')">
                                <span class="txt">Yüksek kalite ses</span>
                                <span class="switch"></span>
                                <input type="checkbox" name="hasHighQualityAudio" id="hasHighQualityAudio" style="display:none;" @(Model.HasHighQualityAudio ? "checked" : "") />
                            </div>
                            <div class="toggle-row @(Model.HasOfflineDownload ? "on" : "")" onclick="toggleFeature(this,'hasOfflineDownload')">
                                <span class="txt">Çevrimdışı dinleme</span>
                                <span class="switch"></span>
                                <input type="checkbox" name="hasOfflineDownload" id="hasOfflineDownload" style="display:none;" @(Model.HasOfflineDownload ? "checked" : "") />
                            </div>
                        </div>
                    </div>

                    <div class="submit-row">
                        <span></span>
                        <button type="submit" class="btn-primary"><i class="bi bi-check-lg"></i>@(isEdit ? "Güncelle" : "Paketi oluştur")</button>
                    </div>
                </form>
            </main>
        </div>
    </div>

    <script>
            function toggleAdsFree(rowEl) {
                rowEl.classList.toggle('on');
                // "on" class'ı = reklamsız aktif = hasAds false olmalı
                document.getElementById('hasAds').checked = !rowEl.classList.contains('on');
            }
            function toggleFeature(rowEl, inputId) {
                rowEl.classList.toggle('on');
                document.getElementById(inputId).checked = rowEl.classList.contains('on');
            }
    </script>
</body>
</html>
