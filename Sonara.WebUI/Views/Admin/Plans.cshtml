@model List<Sonara.WebUI.Services.PlanDto>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sonara Admin — Paketler</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<style>
  :root{
    --sidebar:#111113; --sidebar-hover:#1C1C1F; --sidebar-line:rgba(255,255,255,0.08);
    --bg:#FAFAFB; --surface:#FFFFFF; --border:#EBEBEF; --border-soft:#F2F2F5;
    --text:#0E0E10; --text-dim:#68686F; --text-faint:#9C9CA3;
    --accent:#615FFF; --accent-2:#8B7CFF; --accent-soft:#EFEEFF;
    --green:#0F9D58; --green-soft:#E9F9EF;
    --shadow-sm:0 1px 2px rgba(14,14,16,0.04);
    --shadow-md:0 2px 4px rgba(14,14,16,0.04), 0 12px 28px -14px rgba(14,14,16,0.14);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{background:var(--bg); color:var(--text); font-family:'Inter',sans-serif; min-height:100vh; -webkit-font-smoothing:antialiased;}
  a{color:inherit; text-decoration:none;}

  .shell{display:flex; min-height:100vh;}
  .sidebar{width:236px; flex:none; background:var(--sidebar); color:#fff; padding:20px 14px; display:flex; flex-direction:column; position:sticky; top:0; height:100vh;}
  .sb-brand{display:flex; align-items:center; gap:10px; padding:6px 8px 22px;}
  .sb-brand .mark{width:26px; height:26px; border-radius:7px; background:linear-gradient(135deg, var(--accent), var(--accent-2)); display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:800;}
  .sb-brand .name{font-weight:700; font-size:14.5px; letter-spacing:-0.01em;}
  .sb-brand .name span{color:rgba(255,255,255,0.4); font-weight:500;}
  .sb-search{display:flex; align-items:center; gap:8px; background:var(--sidebar-hover); border:1px solid var(--sidebar-line); border-radius:9px; padding:8px 10px; font-size:12.5px; color:rgba(255,255,255,0.45); margin-bottom:20px;}
  .sb-search kbd{margin-left:auto; font-size:10.5px; background:rgba(255,255,255,0.08); padding:2px 6px; border-radius:5px; font-family:inherit;}
  .sb-section{font-size:10.5px; font-weight:700; letter-spacing:.07em; text-transform:uppercase; color:rgba(255,255,255,0.28); padding:14px 10px 8px;}
  .sb-nav{display:flex; flex-direction:column; gap:1px;}
  .sb-nav a{display:flex; align-items:center; gap:10px; padding:8px 10px; border-radius:8px; font-size:13.5px; font-weight:500; color:rgba(255,255,255,0.62); transition:background .15s, color .15s;}
  .sb-nav a i{font-size:15px; width:16px; text-align:center;}
  .sb-nav a:hover{background:var(--sidebar-hover); color:#fff;}
  .sb-nav a.active{background:rgba(97,95,255,0.18); color:#fff;}
  .sb-nav a.active i{color:var(--accent-2);}
  .sb-foot{margin-top:auto; padding-top:16px; border-top:1px solid var(--sidebar-line);}
  .sb-user{display:flex; align-items:center; gap:10px; padding:8px; border-radius:9px;}
  .sb-user .avatar{width:28px; height:28px; border-radius:50%; background:linear-gradient(135deg,var(--accent),var(--accent-2)); display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700; flex:none;}
  .sb-user .who{font-size:12.5px; font-weight:600;}
  .sb-user .role{font-size:11px; color:rgba(255,255,255,0.4);}

  .content{flex:1; min-width:0;}
  .topbar{position:sticky; top:0; z-index:10; display:flex; align-items:center; justify-content:space-between; padding:0 32px; height:60px; background:rgba(250,250,251,0.85); backdrop-filter:blur(10px); border-bottom:1px solid var(--border);}
  .breadcrumb{font-size:13px; color:var(--text-faint); display:flex; align-items:center; gap:6px;}
  .breadcrumb b{color:var(--text); font-weight:600;}
  .btn-primary{display:flex; align-items:center; gap:6px; padding:7px 14px; border-radius:8px; border:none; font-size:12.5px; font-weight:600; color:#fff; background:var(--accent); box-shadow:var(--shadow-sm); transition:.15s;}
  .btn-primary:hover{background:#5250E8;}

  main{max-width:1220px; margin:0 auto; padding:36px 32px 100px;}
  .page-head{margin-bottom:24px;}
  .page-head h1{font-size:26px; font-weight:800; letter-spacing:-0.02em; margin:0 0 4px;}
  .page-head p{font-size:13.5px; color:var(--text-dim); margin:0;}

  .toast{background:var(--green-soft); color:var(--green); border:1px solid rgba(15,157,88,0.25); padding:12px 18px; border-radius:12px; font-size:13px; font-weight:500; margin-bottom:20px; display:flex; align-items:center; gap:8px;}

  .panel{background:var(--surface); border:1px solid var(--border); border-radius:18px; box-shadow:var(--shadow-sm); overflow:hidden;}
  .table-head-row{display:grid; grid-template-columns:1fr 90px 90px 1.4fr 60px; gap:12px; padding:14px 22px; border-bottom:1px solid var(--border-soft); font-size:11.5px; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:var(--text-faint);}
  .row{display:grid; grid-template-columns:1fr 90px 90px 1.4fr 60px; gap:12px; align-items:center; padding:14px 22px; border-bottom:1px solid var(--border-soft); transition:background .15s; cursor:pointer;}
  .row:last-child{border-bottom:none;}
  .row:hover{background:var(--bg);}
  .row .name{font-size:13.5px; font-weight:600; display:flex; align-items:center; gap:8px;}
  .level-badge{font-size:10.5px; font-weight:700; padding:2px 7px; border-radius:6px; background:var(--accent-soft); color:var(--accent);}
  .row .price{font-size:13px; font-weight:600;}
  .feat-chips{display:flex; gap:6px; flex-wrap:wrap;}
  .feat-chip{font-size:10.5px; font-weight:600; padding:3px 8px; border-radius:6px; background:var(--border-soft); color:var(--text-dim);}
  .feat-chip.on{background:var(--green-soft); color:var(--green);}
  .row .edit-icon{color:var(--text-faint); font-size:14px; transition:color .2s;}
  .row:hover .edit-icon{color:var(--accent);}

  .empty-state{padding:60px 20px; text-align:center; color:var(--text-faint); font-size:13.5px;}

  @@media (max-width:820px){ .sidebar{display:none;} .table-head-row, .row{grid-template-columns:1fr 70px 50px;} .table-head-row span:nth-child(4), .row .feat-chips{display:none;} }
</style>
</head>
<body>

  <div class="shell">
    <aside class="sidebar">
      <div class="sb-brand"><span class="mark">S</span><span class="name">Sonara <span>Admin</span></span></div>
      <div class="sb-search"><i class="bi bi-search"></i>Ara<kbd>⌘K</kbd></div>

      <p class="sb-section">Genel</p>
      <div class="sb-nav"><a href="/Admin/Index"><i class="bi bi-grid-1x2-fill"></i>Genel bakış</a></div>

      <p class="sb-section">Katalog</p>
      <div class="sb-nav">
        <a href="/Admin/Songs"><i class="bi bi-music-note-beamed"></i>Şarkılar</a>
        <a href="/Admin/Artists"><i class="bi bi-person-badge"></i>Sanatçılar</a>
        <a href="/Admin/Moods"><i class="bi bi-palette"></i>Ruh halleri</a>
      </div>

      <p class="sb-section">Sistem</p>
      <div class="sb-nav">
        <a href="/Admin/Plans" class="active"><i class="bi bi-layers"></i>Paketler</a>
        <a href="/Home/Index"><i class="bi bi-box-arrow-up-right"></i>Siteye dön</a>
      </div>

      <div class="sb-foot">
        <div class="sb-user"><span class="avatar">D</span><div><div class="who">Dilan</div><div class="role">Admin</div></div></div>
      </div>
    </aside>

    <div class="content">
      <div class="topbar">
        <div class="breadcrumb">Admin <i class="bi bi-chevron-right" style="font-size:10px;"></i> <b>Paketler</b></div>
        <a href="/Admin/EditPlan" class="btn-primary"><i class="bi bi-plus-lg"></i>Yeni paket</a>
      </div>

      <main>
        <div class="page-head">
          <h1>Paketler</h1>
          <p>@Model.Count üyelik katmanı</p>
        </div>

        @if (TempData["Message"] != null)
        {
            <div class="toast"><i class="bi bi-check-circle-fill"></i>@TempData["Message"]</div>
        }

        <div class="panel">
          @if (Model.Any())
          {
              <div class="table-head-row"><span>Paket</span><span>Seviye</span><span>Fiyat</span><span>Özellikler</span><span></span></div>
              @foreach (var plan in Model)
              {
                  <div class="row" onclick="location.href='/Admin/EditPlan/@plan.Id'">
                      <div class="name">@plan.Name</div>
                      <div><span class="level-badge">Lv @plan.Level</span></div>
                      <div class="price">₺@plan.Price.ToString("0.00")</div>
                      <div class="feat-chips">
                          <span class="feat-chip @(plan.HasAds ? "" : "on")">@(plan.HasAds ? "Reklamlı" : "Reklamsız")</span>
                          <span class="feat-chip @(plan.HasHighQualityAudio ? "on" : "")">Yüksek kalite</span>
                          <span class="feat-chip @(plan.HasOfflineDownload ? "on" : "")">Çevrimdışı</span>
                          <span class="feat-chip">@plan.MaxDeviceCount cihaz</span>
                      </div>
                      <i class="bi bi-pencil edit-icon"></i>
                  </div>
              }
          }
          else
          {
              <div class="empty-state">Henüz paket eklenmemiş.</div>
          }
        </div>
      </main>
    </div>
  </div>

</body>
</html>
