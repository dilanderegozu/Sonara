@model List<Sonara.WebUI.Services.PopularArtistDto>
@{
    Layout = null;
    var heroImage = Model.FirstOrDefault(a => !string.IsNullOrEmpty(a.ImageUrl))?.ImageUrl;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sonara — Sanatçılar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
            :root {
                --bg: #0B0710;
                --surface: #171120;
                --surface-2: #1E1729;
                --text: #FFFFFF;
                --text-dim: rgba(255,255,255,.65);
                --text-faint: rgba(255,255,255,.4);
                --accent: #C64BFF;
                --accent-2: #FF6FA0;
                --accent-3: #6EE7D8;
                --line: rgba(255,255,255,0.10);
            }

            * {
                box-sizing: border-box;
            }

            html, body {
                margin: 0;
                padding: 0;
            }

            body {
                background: var(--bg);
                color: var(--text);
                font-family: 'Inter',sans-serif;
                min-height: 100vh;
            }

            a {
                color: inherit;
                text-decoration: none;
            }

            .topbar {
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                z-index: 20;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 20px clamp(20px,4vw,56px);
            }

            .mark {
                font-weight: 800;
                font-size: 18px;
                letter-spacing: -0.02em;
            }

            .nav-links {
                display: flex;
                gap: 28px;
                font-size: 14px;
                color: rgba(255,255,255,.75);
            }

                .nav-links a {
                    padding-bottom: 4px;
                    border-bottom: 1px solid transparent;
                    transition: .2s;
                }

                    .nav-links a.active {
                        color: #fff;
                        border-color: var(--accent);
                    }

                    .nav-links a:hover {
                        color: #fff;
                    }

            .avatar {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--accent), var(--accent-2));
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                font-size: 13px;
                color: #fff;
            }

            .hero {
                position: relative;
                min-height: 420px;
                overflow: hidden;
                display: flex;
                align-items: flex-end;
                padding: 100px clamp(20px,4vw,56px) 0;
            }

            .hero-photo {
                position: absolute;
                top: 0;
                right: 0;
                bottom: 0;
                width: 56%;
                background-size: cover;
                background-position: center top;
                -webkit-mask-image: linear-gradient(90deg, transparent, #000 32%), linear-gradient(180deg, #000 60%, transparent);
                -webkit-mask-composite: source-in;
                mask-image: linear-gradient(90deg, transparent, #000 32%), linear-gradient(180deg, #000 60%, transparent);
                mask-composite: intersect;
                opacity: .9;
            }

                .hero-photo::after {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background: linear-gradient(180deg, rgba(11,7,16,0), rgba(11,7,16,.55) 88%);
                }

            .hero-fallback {
                position: absolute;
                top: 0;
                right: 0;
                bottom: 0;
                width: 56%;
                background: radial-gradient(ellipse 60% 55% at 70% 30%, rgba(198,75,255,.35), transparent 65%), radial-gradient(ellipse 50% 50% at 40% 75%, rgba(255,111,160,.28), transparent 65%);
            }

            .hero-inner {
                position: relative;
                z-index: 2;
                padding-bottom: 56px;
                max-width: 560px;
            }

            .hero-count {
                font-weight: 800;
                letter-spacing: -0.02em;
                font-size: clamp(32px,4.6vw,54px);
                margin: 0 0 26px;
                line-height: 1;
            }

            .filter-row {
                display: flex;
                align-items: center;
                gap: 10px;
                flex-wrap: wrap;
            }

            .filter-label {
                font-size: 13px;
                color: var(--text-dim);
                margin-right: 6px;
            }

            .filter-pill {
                font-size: 12.5px;
                font-weight: 600;
                color: var(--text-dim);
                background: rgba(255,255,255,.06);
                border: 1px solid var(--line);
                padding: 8px 16px;
                border-radius: 999px;
                cursor: default;
                transition: .2s;
            }

                .filter-pill.active {
                    background: linear-gradient(135deg, var(--accent), var(--accent-2));
                    color: #fff;
                    border-color: transparent;
                }

            main {
                padding: 0 clamp(20px,4vw,56px) 120px;
            }

            .content-grid {
                display: grid;
                grid-template-columns: 1fr 300px;
                gap: 48px;
                margin-top: 44px;
                align-items: start;
            }

            @@media (max-width:900px) {
                .content-grid {
                    grid-template-columns: 1fr;
                }
            }

            .artist-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
                gap: 30px;
            }

            .artist-tile {
                text-align: center;
                cursor: pointer;
            }

            .artist-ring {
                width: 120px;
                height: 120px;
                border-radius: 50%;
                margin: 0 auto;
                position: relative;
                overflow: hidden;
                background: linear-gradient(155deg,#3A2166,#1D1030);
                background-size: cover;
                background-position: center;
                transition: transform .3s cubic-bezier(.2,.7,.2,1);
                box-shadow: 0 18px 36px -18px rgba(0,0,0,.65);
            }

            .artist-tile:hover .artist-ring {
                transform: translateY(-5px) scale(1.03);
            }

            .artist-tile .a-name {
                font-size: 13.5px;
                font-weight: 600;
                margin-top: 14px;
            }

            .side-card {
                background: var(--surface);
                border: 1px solid var(--line);
                border-radius: 16px;
                overflow: hidden;
            }

                .side-card .chart-banner {
                    height: 130px;
                    position: relative;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    text-align: center;
                    padding: 16px;
                    background: linear-gradient(155deg, rgba(198,75,255,.35), rgba(11,7,16,.5));
                    cursor: pointer;
                }

                    .side-card .chart-banner h4 {
                        font-weight: 800;
                        font-size: 19px;
                        margin: 0 0 4px;
                    }

                    .side-card .chart-banner p {
                        font-size: 12px;
                        color: rgba(255,255,255,.75);
                        margin: 0;
                    }

                .side-card .top-tracks {
                    padding: 18px 18px 6px;
                }

                .side-card .top-tracks-title {
                    font-size: 12px;
                    font-weight: 700;
                    color: var(--text-dim);
                    margin: 0 0 14px;
                    text-transform: uppercase;
                    letter-spacing: .06em;
                }

            .top-track-row {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 9px 0;
                cursor: pointer;
            }

                .top-track-row .tt-art {
                    width: 38px;
                    height: 38px;
                    border-radius: 8px;
                    flex: none;
                    background-size: cover;
                    background-position: center;
                    background-color: var(--surface-2);
                }

                .top-track-row .tt-title {
                    font-size: 13px;
                    font-weight: 600;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                .top-track-row .tt-artist {
                    font-size: 11.5px;
                    color: var(--text-dim);
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

            .empty-state {
                text-align: center;
                padding: 80px 20px;
                color: var(--text-dim);
                font-size: 13.5px;
            }

            .hero-inner, .artist-tile, .side-card {
                opacity: 0;
                transform: translateY(10px);
                animation: rise .55s cubic-bezier(.2,.7,.2,1) forwards;
            }

            @@keyframes rise {
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
    </style>
</head>
<body>

    <section class="hero">
        @if (!string.IsNullOrEmpty(heroImage))
        {
            <div class="hero-photo" style="background-image:url('https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQdMbQRrgCErkMVuYZhdDPsgbJjbcus35S45AP-nbYWkA&s=10')"></div>
        }
        else
        {
            <div class="hero-fallback"></div>
        }
        <div class="topbar">
            <div class="mark">Sonara</div>
            <div class="nav-links">
                <a href="/Home/Index">Keşfet</a>
                <a href="/Library/Index">Kütüphane</a>
                <a href="/Artists/Index" class="active">Sanatçılar</a>
                <a href="/Songs/Index">Şarkılar</a>
            </div>
            <div class="avatar">D</div>
        </div>

        <div class="hero-inner">
            <h1 class="hero-count">@Model.Count Sanatçı</h1>
            <div class="filter-row">
                <span class="filter-label">Sırala:</span>
                <span class="filter-pill active">Popülerlik</span>
                <span class="filter-pill">İsim (A–Z)</span>
                <span class="filter-pill">Son eklenen</span>
            </div>
        </div>
    </section>

    <main>
        <div class="content-grid">
            <div>
                @if (Model.Any())
                {
                    <div class="artist-grid">
                        @foreach (var artist in Model)
                        {
                            <div class="artist-tile" onclick="location.href='/Songs/Artist/@artist.ArtistId'">
                                <div class="artist-ring" style="@(string.IsNullOrEmpty(artist.ImageUrl) ? "" : $"background-image:url('{artist.ImageUrl}')")"></div>
                                <div class="a-name">@artist.Name</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">Henüz sanatçı eklenmemiş.</div>
                }
            </div>

            <div class="side-card">
                <div class="chart-banner" onclick="location.href='/Songs/Index'">
                    <h4>Tüm Şarkılar</h4>
                    <p>Katalogdaki her şeyi keşfet.</p>
                </div>
                @if (Model.Any())
                {
                    <div class="top-tracks">
                        <p class="top-tracks-title">Öne çıkan sanatçılar</p>
                        @foreach (var artist in Model.Take(5))
                        {
                            <div class="top-track-row" onclick="location.href='/Songs/Artist/@artist.ArtistId'">
                                <div class="tt-art" style="@(string.IsNullOrEmpty(artist.ImageUrl) ? "" : $"background-image:url('{artist.ImageUrl}')")"></div>
                                <div>
                                    <div class="tt-title">@artist.Name</div>
                                    <div class="tt-artist">@(artist.MonthlyListeners >= 1000000 ? $"{artist.MonthlyListeners / 1000000.0:0.#}M" : $"{artist.MonthlyListeners / 1000}K") dinleyici</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </main>
</body>
</html>
